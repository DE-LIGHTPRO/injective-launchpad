pragma solidity 0.8.28;

/**
 * @title CurveMath
 * @notice Bonding curve arithmetic, ported from `packages/launchpad-math` (Rust).
 *
 * THE RUST IS THE SPEC. This is a port of a working, tested implementation, not a
 * fresh design, and `test/Parity.t.sol` checks it against vectors generated by that
 * implementation rather than against values written by hand here. A port verified
 * only against its own expectations is a rewrite with extra confidence and no extra
 * correctness.
 *
 * Constant product over VIRTUAL reserves, which is what makes the launch one sided:
 * the pool starts with virtual INJ and virtual tokens, so the first buy has a sane
 * price without anyone depositing INJ, and the creator supplies only tokens.
 *
 *   k             = virtualInj * virtualTokens
 *   injReserve    = virtualInj + injCollected
 *   tokenReserve  = virtualTokens - tokensSold
 *
 * ROUNDING IS THE WHOLE RISK OF THIS PORT. Every quote must keep
 * `injReserve * tokenReserve >= k`, and every division is resolved in favour of the
 * pool and against the trader, so repeated trades cannot mine value out of the
 * curve. Rust's `ceil_div` is explicit; Solidity's `/` truncates toward zero. Each
 * place the Rust rounds up is therefore an explicit `ceilDiv` here, and getting one
 * backwards leaks value on every trade without reverting.
 *
 * Solidity 0.8 reverts on overflow for + - *, which replaces Rust's `checked_*`.
 * Amounts are `uint256` throughout rather than `uint128`: the Rust narrows with
 * `to_u128` at the boundaries, and `_toAmount` below is that check.
 */
library CurveMath {
    /// Basis points denominator. 100 bps = 1%.
    uint256 internal constant BPS_DENOM = 10_000;

    /// A launchpad taking more than 10% is a rug with extra steps.
    uint256 internal constant MAX_FEE_BPS = 1_000;

    /// Mirrors Rust's `to_u128` boundary: amounts are u128 in the spec.
    uint256 internal constant MAX_AMOUNT = type(uint128).max;

    error ZeroVirtualReserve();
    error ZeroAmount();
    error Graduated();
    error InsufficientCurveSupply(uint256 requested, uint256 available);
    error InsufficientSold(uint256 requested, uint256 sold);
    error Overflow();
    error FeeTooHigh(uint256 got, uint256 max);
    error UnreachableGraduation(uint256 target, uint256 reachable);

    /// Immutable parameters chosen when a launch is created.
    struct Config {
        uint256 virtualInj;
        uint256 virtualTokens;
        /// Real tokens available on the curve. Must be < virtualTokens.
        uint256 curveSupply;
        /// INJ collected at which the curve closes and liquidity migrates.
        uint256 graduationTarget;
        uint256 feeBps;
    }

    /// Mutable position of a single launch along its curve.
    struct State {
        uint256 injCollected;
        uint256 tokensSold;
        bool graduated;
    }

    struct BuyQuote {
        uint256 fee;
        uint256 injInAfterFee;
        uint256 tokensOut;
        /// Non-zero only on the buy that empties the curve. See `quoteBuy`.
        uint256 refund;
        bool graduates;
    }

    struct SellQuote {
        uint256 fee;
        uint256 injOut;
    }

    // ------------------------------------------------------------ helpers --

    /**
     * Ceiling division. Used wherever rounding must favour the pool: a larger
     * remaining reserve means a smaller payout to the trader.
     *
     * Written as `(num + den - 1) / den` would overflow for the values here, where
     * `k` is around 3e46 and intermediates reach far higher. The explicit remainder
     * form cannot.
     */
    function ceilDiv(uint256 num, uint256 den) internal pure returns (uint256) {
        if (den == 0) revert Overflow();
        uint256 q = num / den;
        // `%` is cheaper than recomputing `q * den` and cannot overflow.
        return num % den == 0 ? q : q + 1;
    }

    /// The `to_u128` boundary from the Rust, kept so the two agree on what overflows.
    function _toAmount(uint256 v) private pure returns (uint256) {
        if (v > MAX_AMOUNT) revert Overflow();
        return v;
    }

    /// k = virtualInj * virtualTokens.
    function k(Config memory cfg) internal pure returns (uint256) {
        return cfg.virtualInj * cfg.virtualTokens;
    }

    /// Fee taken off an input amount, rounded UP so the pool is never short.
    function feeOn(uint256 amount, uint256 bps) internal pure returns (uint256) {
        if (bps == 0) return 0;
        return _toAmount(ceilDiv(amount * bps, BPS_DENOM));
    }

    /**
     * Inverse of `feeOn`: the gross input whose net, after fee, covers `net`.
     * Rounded UP so the pool is never underpaid by a unit.
     */
    function grossUp(uint256 net, uint256 bps) internal pure returns (uint256) {
        if (bps == 0) return net;
        if (bps >= BPS_DENOM) revert FeeTooHigh(bps, MAX_FEE_BPS);
        return _toAmount(ceilDiv(net * BPS_DENOM, BPS_DENOM - bps));
    }

    /// Current reserves implied by the config and state.
    function reserves(Config memory cfg, State memory st)
        internal
        pure
        returns (uint256 inj, uint256 tok)
    {
        inj = cfg.virtualInj + st.injCollected;
        // Reverts on underflow, which is the Rust's `checked_sub` error.
        tok = cfg.virtualTokens - st.tokensSold;
    }

    /// Total INJ the curve can take in before its sellable supply is gone.
    function maxCollectable(Config memory cfg) internal pure returns (uint256) {
        uint256 tokLeft = cfg.virtualTokens - cfg.curveSupply;
        if (tokLeft == 0) revert Overflow();
        uint256 injTotal = ceilDiv(k(cfg), tokLeft);
        uint256 collected = injTotal > cfg.virtualInj ? injTotal - cfg.virtualInj : 0;
        return _toAmount(collected);
    }

    function validate(Config memory cfg) internal pure {
        if (cfg.virtualInj == 0 || cfg.virtualTokens == 0) revert ZeroVirtualReserve();
        if (cfg.feeBps > MAX_FEE_BPS) revert FeeTooHigh(cfg.feeBps, MAX_FEE_BPS);
        // Strictly less: at curveSupply == virtualTokens the reserve hits zero and
        // the curve divides by zero at the asymptote.
        if (cfg.curveSupply >= cfg.virtualTokens) {
            revert InsufficientCurveSupply(cfg.curveSupply, cfg.virtualTokens);
        }
        if (cfg.graduationTarget == 0) revert ZeroAmount();
        uint256 reachable = maxCollectable(cfg);
        if (cfg.graduationTarget > reachable) {
            revert UnreachableGraduation(cfg.graduationTarget, reachable);
        }
    }

    // ------------------------------------------------------------- quotes --

    /**
     * Quote a buy of `injIn`.
     *
     * The partial fill is not an edge case to tidy away. Without it the curve can
     * stall one buy short of graduating, with no way for anyone to finish it: the
     * last buy is filled up to the remaining supply and the rest handed straight
     * back, rather than rejected.
     */
    function quoteBuy(Config memory cfg, State memory st, uint256 injIn)
        internal
        pure
        returns (BuyQuote memory q)
    {
        validate(cfg);
        if (st.graduated) revert Graduated();
        if (injIn == 0) revert ZeroAmount();

        uint256 remaining = cfg.curveSupply - st.tokensSold;
        if (remaining == 0) revert InsufficientCurveSupply(1, 0);

        uint256 feeFull = feeOn(injIn, cfg.feeBps);
        uint256 netFull = injIn - feeFull;
        if (netFull == 0) revert ZeroAmount();

        (uint256 injRes, uint256 tokRes) = reserves(cfg, st);
        uint256 newInj = injRes + netFull;

        // Round the remaining token reserve UP, so tokensOut comes out smaller.
        uint256 newTok = ceilDiv(k(cfg), newInj);
        uint256 wanted = tokRes > newTok ? tokRes - newTok : 0;

        if (wanted <= remaining) {
            q.fee = feeFull;
            q.injInAfterFee = netFull;
            q.tokensOut = wanted;
            q.refund = 0;
        } else {
            // Extracted rather than inlined: this branch needs five more locals than
            // the stack allows here, and the alternative was turning on via_ir
            // globally, which changes codegen for everything to solve one function.
            q = _partialFill(cfg, injRes, tokRes, remaining, injIn);
        }

        if (q.tokensOut == 0) revert ZeroAmount();

        uint256 collectedAfter = st.injCollected + q.injInAfterFee;
        q.graduates = collectedAfter >= cfg.graduationTarget || q.tokensOut == remaining;
    }


    /**
     * The buy that empties the curve: take exactly the INJ needed to clear the
     * remaining supply and hand the rest straight back.
     *
     * Not an edge case to tidy away. Without it the curve can stall one buy short of
     * graduating, with no way for anyone to finish it.
     */
    function _partialFill(
        Config memory cfg,
        uint256 injRes,
        uint256 tokRes,
        uint256 remaining,
        uint256 injIn
    ) private pure returns (BuyQuote memory q) {
        uint256 tokAfter = tokRes - remaining;
        if (tokAfter == 0) revert Overflow();

        // Round the required INJ UP, so the pool is never underpaid.
        uint256 injNeededTotal = ceilDiv(k(cfg), tokAfter);
        uint256 netUsed = injNeededTotal > injRes ? injNeededTotal - injRes : 0;
        if (netUsed == 0) revert ZeroAmount();

        // Gross the net back up so the fee is charged only on what was spent.
        uint256 grossUsed = grossUp(netUsed, cfg.feeBps);
        if (grossUsed > injIn) grossUsed = injIn;

        q.fee = grossUsed > netUsed ? grossUsed - netUsed : 0;
        q.injInAfterFee = netUsed;
        q.tokensOut = remaining;
        q.refund = injIn > grossUsed ? injIn - grossUsed : 0;
    }

    /// Quote a sell of `tokensIn` tokens back to the curve.
    function quoteSell(Config memory cfg, State memory st, uint256 tokensIn)
        internal
        pure
        returns (SellQuote memory q)
    {
        validate(cfg);
        if (st.graduated) revert Graduated();
        if (tokensIn == 0) revert ZeroAmount();
        if (tokensIn > st.tokensSold) revert InsufficientSold(tokensIn, st.tokensSold);

        (uint256 injRes, uint256 tokRes) = reserves(cfg, st);
        uint256 newTok = tokRes + tokensIn;

        // Round the remaining INJ reserve UP, so the payout comes out smaller.
        uint256 newInj = ceilDiv(k(cfg), newTok);
        uint256 gross = injRes > newInj ? injRes - newInj : 0;

        // Can never pay out more than has actually been collected.
        if (gross > st.injCollected) gross = st.injCollected;
        if (gross == 0) revert ZeroAmount();

        q.fee = feeOn(gross, cfg.feeBps);
        q.injOut = gross - q.fee;
    }
}
