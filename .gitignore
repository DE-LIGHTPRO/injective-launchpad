# Rust build output. 809 MB at the time this file was written.
/target

# Node dependencies and Next.js build output.
node_modules/
.next/
out/

# Local configuration. `.env.example` documents the surface; see the note there
# about NEXT_PUBLIC_*.
.env.local
.env*.local
# Anchored on a leading `.env`, which is easy to miss when naming a new file. A
# key file called `DEPLOY-KEY.env.local` is NOT matched by the line above, and git
# listed exactly that as untracked and ready to add while it held a seed phrase.
# Belt and braces: anything whose name contains a secret-shaped word, anywhere.
*mnemonic*
*MNEMONIC*
*seed-phrase*
*.key
*privkey*

.DS_Store
*.log
.vercel

# TypeScript incremental build cache: a build artifact, not source. It was tracked
# and changed on every typecheck, adding noise to every diff.
*.tsbuildinfo
.env*

# Foundry libraries, restored with `forge install` / the clone in evm/README.md.
# Committed as an embedded git repo they are neither a submodule nor files anyone
# can check out, which is the worst of both.
evm/lib/
evm/out/
evm/cache/
# Broadcast records of REAL deployments are worth keeping: they are the only local
# record of what was sent and when. Dry runs and the build cache are not.
evm/broadcast/*/*/dry-run/
