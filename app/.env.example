# Every variable the app reads, documented here because "launch is configuration"
# is only as true as the list someone works through.
#
# NEXT_PUBLIC_* IS INLINED INTO THE CLIENT BUNDLE at build time, exactly like
# Vite's VITE_*. A secret placed in one is published and cannot be rotated
# without a rebuild, so none of these may ever hold one.

# Demo mode. While set, launches are generated locally from the real curve maths
# and the banner says so. Remove it once the factory is deployed and its address
# is configured, and not before: without the banner the page shows prices that
# nothing backs.
NEXT_PUBLIC_DEMO=1

# The deployed factory contract. Unset means there is nothing to read, which is
# why demo mode exists rather than an empty page.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Injective endpoints. Unset falls back to the public testnet in `lib/chain.ts`.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
