# Every variable the app reads, and only those.
#
# This file previously documented NEXT_PUBLIC_CHAIN_ID and NEXT_PUBLIC_RPC_URL,
# which nothing reads, and omitted NEXT_PUBLIC_NETWORK and NEXT_PUBLIC_LCD_URL,
# which it does. Both halves of that are a defect: a variable nothing reads
# advertises a switch that silently does nothing, and a variable the code reads
# but nobody wrote down is a step missing from whatever someone works through
# on deployment day. The list is derived from `grep process.env app/src`, not
# from memory.
#
# NEXT_PUBLIC_* IS INLINED INTO THE CLIENT BUNDLE at build time, exactly like
# Vite's VITE_*. A secret placed in one is published and cannot be rotated
# without a rebuild, so none of these may ever hold one. The deploy script's
# signing key is a separate surface; see scripts/.env.example.

# Demo mode. While set, launches are generated locally from the real curve
# maths and the banner on every page says so. Remove it only once the factory
# is deployed AND its address is set below: without the banner the page shows
# prices that nothing backs.
NEXT_PUBLIC_DEMO=1

# The deployed factory contract. Empty means nothing can be read from chain,
# which is why demo mode exists rather than an empty page. `isDeployed()` is
# this being non-empty.
NEXT_PUBLIC_FACTORY_ADDRESS=

# The site's public URL, used for canonical links, the sitemap and social previews.
# Not a secret. Empty falls back to https://injpad.vercel.app.
NEXT_PUBLIC_SITE_URL=

# Which Injective network. Testnet unless deliberately overridden; mainnet is
# never the default. Anything unrecognised falls back to testnet.
NEXT_PUBLIC_NETWORK=testnet

# Audited curve code ids, comma separated (e.g. `57` or `41,57`). The launch page
# reads each curve's code id and admin from the chain and refuses to offer trading on
# a curve running anything else, or one with an upgrade key. `deploy.mjs` prints the
# value. Empty means not pinned: fine for a dev build, not for production.
NEXT_PUBLIC_CURVE_CODE_IDS=

# LCD endpoint override. Empty uses the verified default for the network above,
# and `isLcdConfigured()` reports false in that case, so nothing can treat "it
# happened to work" as "an operator chose this".
NEXT_PUBLIC_LCD_URL=

# Vercel Blob store token for launch-logo uploads.
#
# NO `NEXT_PUBLIC_` PREFIX: Next inlines those into the client bundle at build time,
# so a key with that prefix is published and cannot be rotated without a rebuild.
# Read only by the /api/upload route.
#
# INJECTED BY THE PLATFORM when a Blob store is attached to the Vercel project, so
# there is nothing to obtain or paste. That is why this replaced a Pinata JWT: the
# pinning route needed a third-party signup before a single creator could upload a
# file, and until somebody did that the drop zone rendered nothing at all.
#
# Without it the route reports itself unconfigured and the create form drops the drop
# zone, leaving the paste-a-link field, which works on its own.
BLOB_READ_WRITE_TOKEN=

# Shared rate limit for logo uploads (Upstash Redis REST). Server-only, no
# `NEXT_PUBLIC_` prefix: the token can write to the database. Without these the limit
# is per server instance, which a serverless platform multiplies. Set both in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
