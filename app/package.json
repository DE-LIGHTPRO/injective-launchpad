{
  "name": "injective-launchpad-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "test": "node --test src/lib/*.test.ts",
