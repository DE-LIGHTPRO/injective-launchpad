# What `node deploy.mjs` reads. None of these are NEXT_PUBLIC_*, deliberately:
# they must not reach the browser bundle.
#
# Supply ONE of the two signing credentials. The script refuses with a clear
# message when neither is present rather than guessing.

# A mnemonic, or a raw private key. Never both, never committed.
# `.gitignore` covers .env*.local, so keep the real values in
# `scripts/.env.local` and nowhere else.
#
# PUT IT IN THE FILE, NOT ON THE COMMAND LINE. `INJ_MNEMONIC="..." node deploy.mjs`
# is recorded by an interactive shell in ~/.zsh_history in plaintext, where it stays
# indefinitely and is readable by anything that reads history. A seed phrase is not
# a password you can rotate. The script refuses to read this file at all if its
# permissions let anyone else on the machine see it:
#
#   cp scripts/.env.example scripts/.env.local
#   chmod 600 scripts/.env.local
#   # then edit it
#
# USE A THROWAWAY ACCOUNT FOR TESTNET. This key signs contract uploads and nothing
# else, so it needs a few INJ from the faucet and no connection to anything you
# hold. A deploy key that is also a personal wallet is a key that is in a terminal,
# in an editor and in a file, for the lifetime of a project.
INJ_MNEMONIC=
INJ_PRIVATE_KEY=

# Fee recipient for the platform's share of trading fees. A launch created with
# this unset would pay fees to an address nobody owns.
INJ_PLATFORM_ADDRESS=

# Where a graduated curve sends its reserve and leftover tokens. This is the
# address that ends up holding the migrated liquidity, so check it twice.
INJ_MIGRATION_TARGET=
