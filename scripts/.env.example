# What `node deploy.mjs` reads. None of these are NEXT_PUBLIC_*, deliberately:
# they must not reach the browser bundle.
#
# Supply ONE of the two signing credentials. The script refuses with a clear
# message when neither is present rather than guessing.

# A mnemonic, or a raw private key. Never both, never committed.
# `.gitignore` covers .env*.local, so keep the real values in
# `scripts/.env.local` and nowhere else.
#
# PUT IT IN THE FILE, NOT ON THE COMMAND LINE. `INJ_MNEMONIC="..." node deploy.mjs`
# is recorded by an interactive shell in ~/.zsh_history in plaintext, where it stays
# indefinitely and is readable by anything that reads history. A seed phrase is not
# a password you can rotate. The script refuses to read this file at all if its
# permissions let anyone else on the machine see it:
#
#   cp scripts/.env.example scripts/.env.local
#   chmod 600 scripts/.env.local
#   # then edit it
#
# USE A THROWAWAY ACCOUNT FOR TESTNET. This key signs contract uploads and nothing
# else, so it needs a few INJ from the faucet and no connection to anything you
# hold. A deploy key that is also a personal wallet is a key that is in a terminal,
# in an editor and in a file, for the lifetime of a project.
INJ_MNEMONIC=
INJ_PRIVATE_KEY=

# REQUIRED. Fee recipient for the platform's share (30%) of every trading fee, on
# the curve and in the locked pool. The script refuses to run without it rather than
# defaulting to the deploy key, and refuses an address that has no account on chain.
INJ_PLATFORM_ADDRESS=

# Who may upgrade the FACTORY's code. Launch contracts have no upgrade key at all,
# so graduated liquidity can never be moved; the factory can, by this address.
#   empty   the deploy key (testnet only; mainnet refuses an empty value)
#   none    no one: the factory is immutable
#   inj1... a multisig, which is what mainnet should use
#
# There is no migration target any more: graduated liquidity stays locked in each
# launch's own contract and is not sent to anyone.
INJ_FACTORY_WASM_ADMIN=

# Who administers the factory's settings: which quote denoms are allowed, which curve
# code FUTURE launches use, and admin handover (two-step). Existing launches are out of
# its reach. Empty = the deploy key, testnet only; mainnet refuses an empty value and
# should use a multisig contract address (DAO DAO / cw3). Leave empty for
# `e2e-testnet.mjs`, which allowlists its own test quote and so must be the admin.
INJ_FACTORY_ADMIN=

# The opening virtual reserve, in WHOLE quote units (590, not 590000000000000000000).
# It sets the market cap every launch on this factory opens at, so it is the one value
# here that shapes the product rather than configuring it.
#
# DERIVE IT, DO NOT COPY IT. The dollar target is a premise about one day's INJ price:
# 676 was derived at INJ $7.92 on 11 Oct 2026, and at $9.09 five days later the same
# constant opens a launch at $5,727 instead of the $5,000 it was chosen for. Run
#
#   node scripts/derive-curve-scale.mjs 5000
#
# which prints where the curve opens, where it graduates and the price impact of
# several buy sizes, and choose on those. Empty keeps 676 on testnet; MAINNET REFUSES
# an empty value, because this used to be a hardcoded literal in deploy.mjs and an
# operator following the runbook exactly would derive one number and deploy another.
INJ_QUOTE_VIRTUAL_WHOLE=

# The launchpad's own one-off charge for creating a launch, in whole INJ, paid to
# the platform wallet in the same transaction. Absent or 0 means no charge, which is
# what testnet runs.
#
# NOT Injective's denom-creation fee. The chain charges its own fee on MsgCreateDenom,
# it goes to the chain, and nothing here can redirect or waive it. A creator on a
# configured mainnet pays both, and the create form itemises them separately so nobody
# reads our 0.2 as the whole cost.
#
# THE TWO CHAINS CHARGE DIFFERENT AMOUNTS. Measured from
# /injective/tokenfactory/v1beta1/params on 16 Oct 2026: testnet 1 INJ, mainnet
# 0.1 INJ. This comment said "a flat 1 INJ", which is testnet's number written down as
# a property of the chain. Carried onto mainnet it would overstate the cost of a launch
# by 0.9 INJ in the pre-flight that decides whether a creator can afford one. See
# `denomCreationFeeFor` in app/src/lib/launchCost.ts, and re-measure rather than
# trusting either figure: `node scripts/mainnet-readiness.mjs` reads it from the chain.
#
# Capped at MAX_LAUNCH_FEE (5 INJ) by the contract.
INJ_LAUNCH_FEE=

# Reuse a code id ALREADY on chain instead of storing the same bytes again, after
# verifying that the stored hash matches what was just built. The right move when only
# one of the two contracts changed, which is most redeploys.
#
# Read as `process.env[`INJ_${label}_CODE_ID`]`, and that is why they went undocumented:
# the guard asserting this file is complete matched dot access only, so both were read
# by the code, absent from here, and reported as fine. A guard's blind spot looks
# exactly like compliance.
#
# Empty stores fresh bytes and prints the new id.
INJ_CURVE_CODE_ID=
INJ_FACTORY_CODE_ID=
